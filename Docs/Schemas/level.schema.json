{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "level.schema.json",
  "title": "Object_Connect tile level",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "background_color", "rules", "layers", "nodes", "connections"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/ascii" },
    "background_color": { "$ref": "#/$defs/color" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_length", "minimum_slack_ratio", "show_target_connections", "vessel"],
      "properties": {
        "total_length": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "minimum_slack_ratio": { "type": "number", "minimum": 1, "maximum": 4 },
        "show_target_connections": { "type": "boolean" },
        "vessel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "base_width", "tip_width", "width_variation"],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "base_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
            "tip_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
            "width_variation": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "obstacles"],
      "properties": {
        "background": { "$ref": "#/$defs/layer" },
        "obstacles": { "$ref": "#/$defs/layer" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type_id", "column", "row", "is_root", "is_goal", "max_incoming", "max_outgoing"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type_id": { "$ref": "#/$defs/id" },
          "column": { "type": "integer", "minimum": 0, "maximum": 79 },
          "row": { "type": "integer", "minimum": 0, "maximum": 44 },
          "is_root": { "type": "boolean" },
          "is_goal": { "type": "boolean" },
          "max_incoming": { "type": "integer", "minimum": 0, "maximum": 32 },
          "max_outgoing": { "type": "integer", "minimum": 0, "maximum": 32 }
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "point_count", "thickness_scale", "follow_delay_seconds", "initial_direction_degrees"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "point_count": { "type": "integer", "minimum": 8, "maximum": 12 },
          "thickness_scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
          "follow_delay_seconds": { "type": "number", "minimum": 0, "maximum": 1 },
          "initial_direction_degrees": { "type": "number", "minimum": -360, "maximum": 360 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "ascii": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?=[ -~]*[!-~])[ -~]+$"
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "layer": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": {
        "type": "array",
        "minItems": 80,
        "maxItems": 80,
        "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    }
  }
}
