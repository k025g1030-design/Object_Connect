{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Object_Connect catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canvas", "tileset", "node_types", "levels"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tile_size"],
      "properties": {
        "width": { "const": 1280 },
        "height": { "const": 720 },
        "tile_size": { "const": 16 }
      }
    },
    "tileset": { "$ref": "#/$defs/json_path" },
    "node_types": { "$ref": "#/$defs/json_path" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/json_path" }
    }
  },
  "$defs": {
    "json_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+/)*(?!\\.{1,2}$)[A-Za-z0-9_.-]+\\.json$"
    }
  }
}
